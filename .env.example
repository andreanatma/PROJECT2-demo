# MODE DEMO: tidak memerlukan database. Semua variabel di bawah ini OPSIONAL.

# URL publik situs (dipakai untuk canonical, sitemap, Open Graph)
SITE_URL="http://localhost:3000"

# Sesi admin (token stateless bertanda tangan). Buat dengan: openssl rand -hex 32
SESSION_SECRET=""
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Akun Super Admin demo (dibuat otomatis setiap server start).
# Jika DEMO_ADMIN_PASSWORD tidak diisi, dipakai akun bawaan: admin@apex-demo.test / Demo-Admin-2026
# dan petunjuknya ditampilkan di halaman login. Isi sendiri bila situs demo bersifat publik.
DEMO_ADMIN_NAME="Super Admin Demo"
DEMO_ADMIN_EMAIL="admin@apex-demo.test"
DEMO_ADMIN_PASSWORD=""
# Isi "false" untuk tidak membuat akun demo (lalu pakai /dashboard-admin/signup + BOOTSTRAP_TOKEN)
DEMO_SEED_ADMIN="true"
BOOTSTRAP_TOKEN=""

# Batas upload (MB). Default 4 karena batas body fungsi serverless (mis. Vercel) sekitar 4,5 MB.
MAX_UPLOAD_MB=4
